/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self'; style-src 'self'; font-src 'self'; img-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/style.css
  Cache-Control: no-cache

/fonts/*
  Cache-Control: public, max-age=31536000, immutable

/img/*
  Cache-Control: public, max-age=31536000, immutable

/play/land.json
  Cache-Control: public, max-age=31536000, immutable

# The Cambio game (built files only; source is in conradicle/cambio-game).
# Same policy as /* plus one thing: connect-src allows the game server's
# socket. The site-wide CSP is detached first, because two CSP headers are
# enforced separately and the site's connect-src 'self' would block it.
/cambio/*
  ! Content-Security-Policy
  Content-Security-Policy: default-src 'none'; script-src 'self'; connect-src 'self' https://cambio-server.conradgelber.com wss://cambio-server.conradgelber.com; style-src 'self'; font-src 'self'; img-src 'self'; manifest-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

/cambio/assets/*
  Cache-Control: public, max-age=31536000, immutable
