{
  "name": "conradgelber-play",
  "private": true,
  "type": "module",
  "description": "Source for the browser games: /play/ (pin drop) builds to ../play/play.js, /flight-path/ to ../flight-path/flight-path.js, /pool/ to ../pool/pool.js, /borderline/ to ../borderline/borderline.js, /historybowl/ to ../historybowl/historybowl.js, /12axes/ to ../12axes/12axes.js.",
  "scripts": {
    "build": "esbuild src/main.js --bundle --minify --format=iife --target=es2019 --outfile=../play/play.js",
    "build:flight": "esbuild src/flight-path/main.js --bundle --minify --format=iife --target=es2019 --outfile=../flight-path/flight-path.js",
    "build:pool": "node scripts/pool-version.mjs && esbuild src/pool/main.js --bundle --minify --format=iife --target=es2019 --define:POOL_DEV=false --outfile=../pool/pool.js",
    "land": "node scripts/copy-land.mjs",
    "check-places": "node scripts/check-places.mjs",
    "countries": "node scripts/copy-countries.mjs",
    "routes": "node scripts/build-routes.mjs",
    "test": "node scripts/pool-version.mjs --check && node --test \"test/*.test.mjs\"",
    "build:borderline": "esbuild src/borderline/main.js --bundle --minify --format=iife --target=es2019 --outfile=../borderline/borderline.js",
    "borderline:data": "node scripts/borderline/fetch-sources.mjs && node scripts/borderline/build-geo.mjs && node scripts/borderline/build-bank.mjs && node scripts/borderline/build-curated.mjs && node scripts/borderline/build-maps.mjs",
    "build:historybowl": "esbuild src/historybowl/main.js --bundle --minify --format=iife --target=es2019 --outfile=../historybowl/historybowl.js",
    "build:12axes": "esbuild src/12axes/main.js --bundle --minify --format=iife --target=es2019 --outfile=../12axes/12axes.js",
    "12axes:data": "node scripts/12axes/import-source.mjs"
  },
  "dependencies": {
    "d3-geo": "3.1.1",
    "d3-selection": "3.0.0",
    "d3-zoom": "3.0.0",
    "topojson-client": "3.1.0",
    "ts-fsrs": "5.4.2"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2",
    "esbuild": "0.28.2",
    "mapshaper": "0.7.85",
    "pdfjs-dist": "6.3.289",
    "world-atlas": "2.0.2",
    "xz-decompress": "0.2.3"
  }
}
