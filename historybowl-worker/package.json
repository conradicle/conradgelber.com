{
  "name": "conradgelber-historybowl-worker",
  "private": true,
  "type": "module",
  "description": "History Bowl Study's Worker: the QB Reader proxy and answer checks, routed at conradgelber.com/historybowl/api.",
  "scripts": {
    "dev": "node scripts/dev-assets.mjs && wrangler dev -c wrangler.dev.jsonc --port 8801",
